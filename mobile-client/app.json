{
  "expo": {
    "name": "SteerByPhone",
    "slug": "steerbyphone-client",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.steerbyphone.client"
    },
    "android": {
      "package": "com.steerbyphone.client",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "cc530d76-5756-4b4b-aec5-51c573199ca7"
      }
    }
  }
}
